<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- 00_MASTER_SPEC.md § 7.11 — Swagger surfaces the XML <summary> docs on controller
         actions, so they are generated here despite being suppressed solution-wide. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\MathilensERP.Application.csproj" />
    <ProjectReference Include="..\Infrastructure\MathilensERP.Infrastructure.csproj" />
    <ProjectReference Include="..\Domain\MathilensERP.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

</Project>
