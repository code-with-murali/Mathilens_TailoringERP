# RADHA APPARELS — website configuration
#
# Copy to .env.local and fill in the values RADHA confirms. Every one of these is optional at
# build time: an unset value removes the feature it powers rather than showing a placeholder to
# a visitor. `npm run dev` prints a checklist of what is still missing.

# --- Required before the site goes live -------------------------------------------------------
# Canonical URLs, Open Graph tags, the sitemap and structured data are all built from this.
# Leave unset locally; set it to the real domain (no trailing slash) in the deployment.
NEXT_PUBLIC_SITE_URL=

# --- Contact ----------------------------------------------------------------------------------
# International format, digits only: 91 followed by the 10-digit number.
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_EMAIL=

# The street address, postal code, opening hours and shop coordinates are edited directly in
# src/content/site.ts — they are structured values rather than single strings.

# --- Google Business Profile / Maps ------------------------------------------------------------
# Maps → Share → Embed a map → copy the src="" out of the iframe.
NEXT_PUBLIC_MAP_EMBED_URL=
# A plain maps link for the "Get directions" button.
NEXT_PUBLIC_MAP_DIRECTIONS_URL=
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=

# --- Listings and social -----------------------------------------------------------------------
NEXT_PUBLIC_JUSTDIAL_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# --- Online store -------------------------------------------------------------------------------
# The separate shopping platform. Until this is set, /shop explains that the store is on its way
# and points visitors at the shop and the enquiry form instead.
NEXT_PUBLIC_STORE_URL=

# --- Enquiry form --------------------------------------------------------------------------------
# An HTTPS endpoint accepting a JSON POST of the enquiry. Without it the form hands the enquiry to
# WhatsApp, and failing that to email.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=

# --- Analytics ------------------------------------------------------------------------------------
# GA4 measurement id. No analytics script loads and no event fires while this is empty.
NEXT_PUBLIC_GA4_ID=
# Only needed if Search Console is verified by HTML tag rather than by DNS.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
